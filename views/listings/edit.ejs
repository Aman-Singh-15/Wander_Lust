<% layout("/layouts/boilerplate") %>

    <div class="row offset-2 mt-3">
        <div class="col-8">
        <h3><b>Edit your Listing here :</b> </h3>
     <form method="POST", action="/listings/<%=data._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <div class="mb-3">
            <label for="title" class="form-label"><b>Title :</b> </label>
        <input name=listing[title] value="<%=data.title%>" type="text" class="form-control" required >
          <div class="invalid-feedback">Title must not be Empty!</div>

                </div>
        
   

        <div class="mb-3">
            <label for="description" class="form-label"><b>Description :</b></label>
             <textarea name=listing[description] type="text" class="form-control"  required>"<%=data.description%>"</textarea>
              <div class="invalid-feedback">Descrtiption is too short!</div>
        </div>

         <div class="mb-3">
            <label for="description" class="form-label"><b>Original Image :</b></label>
                <img class="org-image" src="<%=originalImageUrl%>">
            </div>
            
            <div class="mb-3">
                 <label for="image" class="form-label"><b>Upload New Image :</b> </label>
                 <input name=listing[image] type="file" class="form-control" >
                 <div class="invalid-feedback">Insert a Image</div>   
            </div>
          
        <div class="row">
            <div class="mb-3 col-md-4" >
            <label for="price" class="form-label"><b>Price :</b></label>
             <input type="number" name=listing[price] value="<%=data.price%>" type="text" class="form-control"  required >
             <div class="invalid-feedback">Price must contains numbers only!</div>
            </div>
         
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label"><b>Country :</b></label>
                 <input name= "listing[country]" value="<%=data.country%>"  class="form-control"  required pattern="[A-Za-z, .]+" >
                  <div class="invalid-feedback">Invalid Country!</div>
            </div>
     </div>

            <div class="mb-3 col-md-4">
            <label for="location" class="form-label"><b>Location :</b></label>
            <input name= "listing[location]" value="<%=data.location%>"  class="form-control"  required pattern="[A-Za-z, .]+" >
             <div class="invalid-feedback">Location is Required!</div>
            </div>
            <br>
                <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </form>
        </div>
        </div>
    </div>
        
    

